# Flask Configuration
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database
DATABASE_URL=sqlite:///health_app.db

# Gemini API (Get your key from: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Knowledge Graph Paths
KG_NODE_PATH=dataset/neo4j_node.csv
KG_REL_PATH=dataset/neo4j_rel.csv
EMBEDDINGS_CACHE_PATH=cache/entity_embeddings_cache.npz

# Sentence Transformer Model
SENTENCE_MODEL_NAME=all-MiniLM-L6-v2

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
